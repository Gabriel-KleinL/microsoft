# ============================================
# Microsoft Azure AD / Graph API Configuration
# ============================================

# Obtenha estes valores registrando um aplicativo no Azure Portal
# Tutorial completo no README.md

# Client ID do aplicativo Azure AD
MICROSOFT_CLIENT_ID=seu-client-id-aqui

# Client Secret (senha do aplicativo)
MICROSOFT_CLIENT_SECRET=seu-client-secret-aqui

# Tenant ID (ID do diretório Azure AD)
MICROSOFT_TENANT_ID=seu-tenant-id-aqui

# URL de redirecionamento após autenticação (não alterar em desenvolvimento)
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback


# ============================================
# SharePoint Configuration
# ============================================

# URL completa do seu site SharePoint
# Exemplo: https://suaempresa.sharepoint.com/sites/NomeDoSite
SHAREPOINT_SITE_URL=https://fiofortei9automacaogroup.sharepoint.com/sites/Documentos


# ============================================
# Claude AI (Anthropic) Configuration
# ============================================

# Sua chave de API da Anthropic
# Obtenha em: https://console.anthropic.com/
CLAUDE_API_KEY=sua-chave-api-claude-aqui

# Modelo Claude a ser usado (recomendado: claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022


# ============================================
# Flask Configuration
# ============================================

# Chave secreta para sessões Flask (gere uma aleatória para produção)
SECRET_KEY=mude-esta-chave-em-producao

# Ambiente Flask (development ou production)
FLASK_ENV=development
